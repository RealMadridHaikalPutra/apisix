{
  "_syntax": {
    "alternative_paths": "Nilai 'source' (dan path pagination/product_root/skus.source) mendukung '||': path dinilai berurutan, nilai non-nil PERTAMA yang dipakai. Contoh: 'model_sku || item_sku || id'. Transform tetap dijalankan sekali pada nilai akhir. Legacy _alt/_fallback field entries tetap didukung.",
    "collect": "Notasi '[]' mengumpulkan nilai dari semua elemen array (mis. 'skus[].inventory[].quantity' + transform 'sum'). Dapat digabung dengan '||' — kandidat pertama yang menghasilkan koleksi tidak kosong yang dipakai."
  },
  "products": {
    "tiktok": {
      "description": "TikTok product list standardization",
      "product_root": "data.products",
      "pagination": {
        "total_count": "data.total_count || data.data.total_count",
        "next_page_token": "data.next_page_token || data.data.next_page_token"
      },
      "fields": {
        "external_product_id": { "source": "id", "transform": "content_map", "map_field": "product_id", "default": "" },
        "product_name": { "source": "title", "default": null, "nullable": true },
        "product_image": { "source": "_detail.data.main_images[0].urls[0]", "default": null, "nullable": true },
        "product_image_alt": { "source": "_detail.data.main_images[0].uri", "transform": "uri_to_url", "nullable": true },
        "category": { "source": "_detail.data.category_chains[-1].local_name", "default": null, "nullable": true },
        "description": { "source": "_detail.data.description || description", "transform": "strip_html", "default": null, "nullable": true },
        "status": { "source": "status || integrated_platform_statuses.status", "transform": "content_map", "map_field": "status", "default": "" },
        "location_id": { "source": "_detail.data.skus[0].inventory[0].warehouse_id || skus[0].warehouse_inventory[0].warehouse_id || skus[0].inventory[0].warehouse_id", "transform": "string", "default": "" },
        "total_available": { "source": "skus[].total_available_quantity || skus[].inventory[].quantity", "transform": "sum", "default": 0 },
        "total_reserved": { "source": "skus[].total_committed_quantity || skus[].inventory[].committed_quantity", "transform": "sum", "default": 0 }
      },
      "skus": {
        "source": "_detail.data.skus",
        "fields": {
          "external_variant_id": { "source": "id", "transform": "string", "default": "" },
          "variant_name": { "source": "sales_attributes[0].name", "nullable": true },
          "seller_sku": { "source": "seller_sku || sku_code || id", "transform": "string", "default": "", "nullable": true },
          "inventory": { "source": "inventory", "transform": "map_inventory", "default": [] },
          "status": { "source": "status_info.status", "transform": "content_map", "map_field": "status", "default": "" }
        }
      },
      "validation": {
        "description": "Jika salah satu variabel wajib TIDAK MUNCUL atau bernilai 0/'' pada salah satu produk, gateway membalas HTTP error (default 500) supaya mapping diperbaiki lebih dulu. Tambahkan field lain di required_fields bila perlu (misal \"total_available\" jika harus > 0).",
        "required_fields": ["external_product_id", "product_name", "status"],
        "error_status": 500
      }
    },
    "shopee": {
      "description": "Shopee product list standardization",
      "product_root": "response.item",
      "pagination": {
        "total_count": "response.total_count || response.item_count",
        "has_next": "response.has_more || response.has_next_page",
        "next_page_token": "response.next_cursor || response.next_offset"
      },
      "fields": {
        "external_product_id": { "source": "item_id", "transform": "content_map", "map_field": "product_id", "default": "" },
        "product_name": { "source": "_detail.item_name || item_name", "default": null, "nullable": true },
        "product_image": { "source": "_detail.image.image_url_list[0]", "default": null, "nullable": true },
        "category": { "source": "_detail.category_id", "transform": "string", "default": null, "nullable": true },
        "description": { "source": "_detail.description_info.extended_description.field_list[].text", "transform": "concat_strip_html", "default": null, "nullable": true },
        "status": { "source": "item_status", "transform": "content_map", "map_field": "status", "default": "" },
        "inventory": { "source": "_model_raw.model[0].stock_info_v2.seller_stock", "transform": "map_inventory", "default": [] },
        "location_id": { "source": "_model_raw.model[0].stock_info_v2.seller_stock[0].location_id || location_id", "transform": "string", "default": "", "nullable": true },
        "total_available": { "source": "_model_raw.model[0].stock_info_v2.summary_info.total_available_stock || stock", "default": 0 },
        "total_reserved": { "source": "_model_raw.model[0].stock_info_v2.summary_info.total_reserved_stock", "default": 0 }
      },
      "skus": {
        "source": "_model_raw.model",
        "description": "SKU variants dari get_model_list. Produk TANPA variant (has_model=false → model list kosong) di-fallback ke satu SKU sintetis dari data item-level (fallback_to_item) sehingga array `skus` tidak pernah kosong — seller_sku diambil dari item_sku.",
        "fallback_to_item": true,
        "fields": {
          "external_variant_id": { "source": "model_id", "transform": "string", "default": "" },
          "variant_name": { "source": "model_name", "nullable": true },
          "seller_sku": { "source": "model_sku || item_sku", "default": "", "nullable": true },
          "total_reserved_stock": { "source": "stock_info_v2.summary_info.total_reserved_stock", "default": 0 },
          "total_available_stock": { "source": "stock_info_v2.summary_info.total_available_stock", "default": 0 },
          "status": { "source": "model_status", "transform": "content_map", "map_field": "status", "default": "" }
        },
        "fallback_fields": {
          "external_variant_id": { "source": "item_id", "transform": "string", "default": "" },
          "variant_name": { "source": "_detail.item_name", "nullable": true },
          "seller_sku": { "source": "_detail.item_sku || item_sku", "default": "" },
          "total_reserved_stock": { "source": "stock_info_v2.summary_info.total_reserved_stock", "default": 0 },
          "total_available_stock": { "source": "stock_info_v2.summary_info.total_available_stock", "default": 0 },
          "status": { "source": "item_status", "transform": "content_map", "map_field": "status", "default": "" }
        }
      },
      "validation": {
        "description": "Jika salah satu variabel wajib TIDAK MUNCUL atau bernilai 0/'' pada salah satu produk, gateway membalas HTTP error (default 500) supaya mapping diperbaiki lebih dulu. Tambahkan field lain di required_fields bila perlu (misal \"total_available\" jika harus > 0).",
        "required_fields": ["external_product_id", "product_name", "status"],
        "error_status": 500
      }
    },
    "lazada": {
      "description": "Lazada product list standardization (GetProducts: data.products[]). images Lazada berupa JSON-encoded string → transform json_first.",
      "product_root": "data.products",
      "pagination": {
        "total_count": "data.total_products",
        "has_next": "data.has_more"
      },
      "fields": {
        "external_product_id": { "source": "item_id", "transform": "content_map", "map_field": "product_id", "default": "" },
        "product_name": { "source": "attributes.name", "default": null, "nullable": true },
        "product_image": { "source": "images || skus[0].Images[0]", "transform": "json_first", "default": null, "nullable": true },
        "category": { "source": "primary_category", "transform": "string", "default": null, "nullable": true },
        "description": { "source": "attributes.description", "transform": "strip_html", "default": null, "nullable": true },
        "status": { "source": "status", "transform": "content_map", "map_field": "status", "default": "" },
        "location_id": { "source": "warehouse_code", "transform": "string", "default": "" },
        "total_available": { "source": "skus[].quantity", "transform": "sum", "default": 0 },
        "total_reserved": { "source": "skus[].ReservedStock", "transform": "sum", "default": 0 }
      },
      "skus": {
        "source": "skus",
        "description": "SKU Lazada: SkuId = variant id, SellerSku = SKU seller, quantity = stok tersedia, ReservedStock = stok tertahan (butuh options=1 di GetProducts).",
        "fields": {
          "external_variant_id": { "source": "SkuId", "transform": "string", "default": "" },
          "variant_name": { "source": "SkuDesc", "nullable": true },
          "seller_sku": { "source": "SellerSku", "default": "", "nullable": true },
          "total_available_stock": { "source": "quantity", "default": 0 },
          "total_reserved_stock": { "source": "ReservedStock", "default": 0 },
          "status": { "source": "Status", "transform": "content_map", "map_field": "status", "default": "" }
        }
      },
      "validation": {
        "description": "Jika salah satu variabel wajib TIDAK MUNCUL atau bernilai 0/'' pada salah satu produk, gateway membalas HTTP error (default 500) supaya mapping diperbaiki lebih dulu.",
        "required_fields": ["external_product_id", "product_name", "status"],
        "error_status": 500
      }
    }
  },
  "orders": {
    "shopee": {
      "description": "Shopee order reserved-stock standardization",
      "output_key": "reserved_stock",
      "product_root": "reserved_stock",
      "pagination": {
        "total_count": "total_count",
        "has_next": "has_more",
        "next_page_token": "next_page_token"
      },
      "fields": {
        "product_id": { "source": "product_id", "transform": "string", "default": "" }
      },
      "skus": {
        "source": "variants",
        "output_key": "variants",
        "fields": {
          "variant_id": { "source": "variant_id", "transform": "string", "default": "" },
          "seller_sku": { "source": "seller_sku", "default": "" },
          "total_reserved_stock": { "source": "total_reserved_stock", "default": 0 },
          "orders": { "source": "orders", "transform": "as_array", "default": [] }
        }
      }
    },
    "tiktok": {
      "description": "TikTok order reserved-stock standardization",
      "output_key": "reserved_stock",
      "product_root": "reserved_stock",
      "pagination": {
        "total_count": "total_count",
        "has_next": "has_more",
        "next_page_token": "next_page_token"
      },
      "fields": {
        "product_id": { "source": "product_id", "transform": "string", "default": "" }
      },
      "skus": {
        "source": "variants",
        "output_key": "variants",
        "fields": {
          "variant_id": { "source": "variant_id", "transform": "string", "default": "" },
          "seller_sku": { "source": "seller_sku", "default": "" },
          "total_reserved_stock": { "source": "total_reserved_stock", "default": 0 },
          "orders": { "source": "orders", "transform": "as_array", "default": [] }
        }
      }
    },
    "lazada": {
      "description": "Lazada order reserved-stock standardization (GetOrders + GetOrderItems)",
      "output_key": "reserved_stock",
      "product_root": "reserved_stock",
      "pagination": {
        "total_count": "total_count",
        "has_next": "has_more",
        "next_page_token": "next_page_token"
      },
      "fields": {
        "product_id": { "source": "product_id", "transform": "string", "default": "" }
      },
      "skus": {
        "source": "variants",
        "output_key": "variants",
        "fields": {
          "variant_id": { "source": "variant_id", "transform": "string", "default": "" },
          "seller_sku": { "source": "seller_sku", "default": "" },
          "total_reserved_stock": { "source": "total_reserved_stock", "default": 0 },
          "orders": { "source": "orders", "transform": "as_array", "default": [] }
        }
      }
    }
  }
}
